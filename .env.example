# ─── MapR1 Environment Variables ──────────────────────────────────────────────
# Copy this file to .env and fill in your values.

# App
DEBUG=true
APP_NAME=MapR1
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# LLM Provider — switch between 'groq' (cloud), 'ollama' (local), or 'openrouter'
LLM_PROVIDER=groq

# Groq (cloud) — get a free API key at https://console.groq.com
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama (local) — only needed when LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b

# OpenRouter (for scenario seeder) — get API key at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Supabase
SUPABASE_URL=https://ygtzasxbpizkupixmgcg.supabase.co
SUPABASE_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=sb_secret_APn...
SUPABASE_DB_PASSWORD=your-password-here

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres.ygtzasxbpizkupixmgcg:${SUPABASE_DB_PASSWORD}@aws-1-ap-south-1.pooler.supabase.com:5432/postgres

# Simulation Settings
MAX_SCENARIOS=5
MAX_TIMELINE_EVENTS=10
SCENARIO_TEMPERATURE=0.8
MAX_TOKENS=4000
